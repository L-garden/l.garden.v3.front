{
  "name": "l.garden",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-menu-board": "rm -rf public/menu-board && mkdir -p public/menu-board && cp -R menu-board/tv.html menu-board/board.css menu-board/fonts menu-board/images menu-board/season.js menu-board/seasons public/menu-board/",
    "predev": "npm run copy-menu-board",
    "prebuild": "npm run copy-menu-board",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "15.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "typescript": "^5"
  }
}
